CLOUD_EXPERT_ENV=development
DATABASE_URL=sqlite:///./cloud_expert_dev.sqlite
POSTGRES_DATABASE_URL=postgresql+psycopg://cloud_expert:cloud_expert_password@localhost:54329/cloud_expert_test
TEST_DATABASE_URL=sqlite:///:memory:
CLOUD_EXPERT_RAW_DATA_DIR=./data/raw
CLOUD_EXPERT_SOURCE_REGISTRY_DIR=./data/source_registry
CLOUD_EXPERT_HTTP_TIMEOUT_SECONDS=30
CLOUD_EXPERT_HTTP_MAX_RETRIES=3
CLOUD_EXPERT_HTTP_MIN_INTERVAL_SECONDS=2
CLOUD_EXPERT_MAX_DOWNLOAD_BYTES=10485760
CLOUD_EXPERT_MAX_CONCURRENCY=1
CLOUD_EXPERT_ENABLE_NETWORK_TESTS=false
CLOUD_EXPERT_ALLOW_LOCALHOST_FOR_TESTS=false
REVIEW_MODEL_PROVIDER=openai
REVIEW_MODEL_NAME=gpt-6-astra
REVIEW_MODEL_TIER=highest_reasoning
REVIEW_MODEL_TEMPERATURE=0
REVIEW_MODEL_MAX_RETRIES=2
REVIEW_MODEL_TIMEOUT_SECONDS=180
ALLOW_REVIEW_MODEL_FALLBACK=false
# Optional future API runtime. Leave empty; never commit a real value.
OPENAI_API_KEY=
# Read-only Huawei pricing query. Runtime environment only; .env is not auto-loaded.
# Prefer query_huawei_prices.py --interactive to avoid persistent credential storage.
HUAWEICLOUD_AUTH_TOKEN=
HUAWEICLOUD_PROJECT_ID=
